# cube.obj — the Lesson-11/12 cube, as a file (Lesson 15).
# 8 corner positions, 4 UVs, 6 face normals. Each face is ONE QUAD
# ("f a/b/c d/b/c e/b/c f/b/c") so the loader's fan triangulation is
# exercised: 6 quads -> 12 triangles -> 36 indices.
# Winding is CCW seen from outside each face (Lesson-11 verified).
# Note the dedup math: 8 positions x 4 UVs x 6 normals combine into
# 24 distinct (v, vt, vn) triples — exactly the 24 vertices the
# procedural cube used. Same cube, now loaded from disk.

v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vn  1.0  0.0  0.0
vn -1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  0.0  1.0
vn  0.0  0.0 -1.0

# +X face (normal 1): verts 6,2,3,7
f 6/1/1 2/2/1 3/3/1 7/4/1
# -X face (normal 2): verts 1,5,8,4
f 1/1/2 5/2/2 8/3/2 4/4/2
# +Y face (normal 3): verts 8,7,3,4
f 8/1/3 7/2/3 3/3/3 4/4/3
# -Y face (normal 4): verts 1,2,6,5
f 1/1/4 2/2/4 6/3/4 5/4/4
# +Z face (normal 5): verts 5,6,7,8
f 5/1/5 6/2/5 7/3/5 8/4/5
# -Z face (normal 6): verts 2,1,4,3
f 2/1/6 1/2/6 4/3/6 3/4/6
